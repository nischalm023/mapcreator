{
  "$schema": "http://json-schema.org/schema#",
  "$id": "map",
  "title": "mapcreator's internal representation of map",
  "type": "object",
  "required": ["elevators", "zones", "sectors", "sectorBarcodeMapping", "sectorMxUPreferences", "queueDatas", "floors"],
  "additionalProperties": true,
  "properties": {
    "conveyors": {
      "type": "array",
      "items": [
    {
      "type": "object",
      "properties": {
        "conveyor_id": {
          "type": "integer"
        },
        "map_entry_location": {
          "type": "string"
        },
        "map_exit_location": {
          "type": "string"
        },
        "conveyor_entry_location": {
          "type": "string"
        },
        "conveyor_exit_location": {
          "type": "string"
        },
        "conveyor_height": {
          "type": "integer"
        },
        "adjacency": {
          "type": "array",
          "items": [
            {
              "type": "null"
            },
            {
              "type": "null"
            },
            {
              "type": "null"
            },
            {
              "type": "null"
            }
          ]
        },
        "steps": {
          "type": "array",
          "items": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "type": {
                  "type": "string"
                },
                "coordinate": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type",
                "coordinate"
              ]
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "type": {
                  "type": "string"
                },
                "coordinate": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type",
                "coordinate"
              ]
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "type": {
                  "type": "string"
                },
                "coordinate": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type",
                "coordinate"
              ]
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "type": {
                  "type": "string"
                },
                "coordinate": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type",
                "coordinate"
              ]
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "type": {
                  "type": "string"
                },
                "coordinate": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type",
                "coordinate"
              ]
            },
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "type": {
                  "type": "string"
                },
                "coordinate": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type",
                "coordinate"
              ]
            }
          ]
        }
      },
      "required": [
        "conveyor_id",
        "conveyor_height"
      ]
    }
  ]
    },
    "elevators": {
      "type": "array",
      "items": {
        "$ref": "elevator"
      }
    },
    "zones": {
      "type": "array",
      "items": { "$ref": "zone" }
    },
    "sectors": {
      "type": "array",
      "items": { "$ref": "sector" }
    },
    "queueDatas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["queue_data_id", "coordinates", "data"],
        "properties": {
          "queue_data_id": { "type": "integer" },
          "coordinates": {
            "type": "array",
            "items": { "$ref": "definitions#/coordinateKey" }
          },
          "data": { "$ref": "queueData" }
        }
      }
    },
    "floors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "floor_id",
          "map_values",
          "chargers",
          "ppses",
          "odsExcludeds",
          "dockPoints",
          "fireEmergencies"
        ],
        "additionalProperties": true,
        "properties": {
          "floor_id": { "type": "integer", "minimum": 1 },
          "map_values": {
            "type": "array",
            "items": { "$ref": "barcodeWithNumberCoordinate" }
          },
          "chargers": {
            "type": "array",

            "items": {
              "allOf": [
                {
                  "type": "object",
                  "required": ["charger_id", "coordinate"],
                  "properties": {
                    "charger_id": { "type": "integer" },
                    "coordinate": { "$ref": "definitions#/coordinateKey" }
                  }
                },
                { "$ref": "charger" }
              ]
            }
          },
          "ppses": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "type": "object",
                  "required": ["pps_id", "coordinate"],
                  "properties": {
                    "pss_id": { "type": "integer" },
                    "coordinate": { "$ref": "definitions#/coordinateKey" }
                  }
                },
                { "$ref": "pps" }
              ]
            }
          },
          "odsExcludeds": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "type": "object",
                  "required": ["ods_excluded_id", "coordinate"],
                  "properties": {
                    "ods_excluded_id": { "type": "integer" },
                    "coordinate": { "$ref": "definitions#/coordinateKey" }
                  }
                },
                { "$ref": "odsExcluded" }
              ]
            }
          },
          "dockPoints": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "type": "object",
                  "required": ["dock_point_id", "coordinate"],
                  "properties": {
                    "dock_point_id": { "type": "integer" },
                    "coordinate": { "$ref": "definitions#/coordinateKey" }
                  }
                },
                { "$ref": "dockPoint" }
              ]
            }
          },
          "fireEmergencies": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "type": "object",
                  "required": ["fire_emergency_id", "coordinate"],
                  "properties": {
                    "fire_emergency_id": { "type": "integer" },
                    "coordinate": { "$ref": "definitions#/coordinateKey" }
                  }
                },
                { "$ref": "fireEmergency" }
              ]
            }
          }
        }
      }
    }
  }
}
